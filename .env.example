# App server — Bun tự nạp .env ở thư mục repo
MARKET_BASE_URL=https://market.example.vn
# MARKET_BYPASS=1                # tắt kiểm tra subscription khi phát triển
# MARKET_ALLOW_PLUGIN_ADMIN=1    # cho phép cài plugin thủ công

# Nguồn cập nhật desktop (bắt buộc nếu muốn tự cập nhật)
TOONFLOW_DESKTOP_UPDATE_URL=
TOONFLOW_GITHUB_RELEASES_URL=

# Telemetry riêng cho web (bỏ trống = tắt)
VITE_TELEMETRY_URL=

# Thương hiệu khi build
APP_NAME=
APP_IDENTIFIER=
VITE_APP_NAME=
VITE_REPO_URL=
VITE_DOCS_URL=
VITE_COMMUNITY_URL=
RELEASE_BASE_URL=
